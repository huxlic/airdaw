* text=auto

# TypeScript
*.ts diff=typescript
*.tsx diff=typescript

# Mark generated/vendor files as non-detectable
public/**/*.js linguist-generated=true
public/**/*.wasm linguist-generated=true
node_modules/** linguist-generated=true
dist/** linguist-generated=true

# Configuration files
eslint.config.js linguist-language=JavaScript
tsconfig*.json linguist-language=JSON
vite.config.ts linguist-language=TypeScript
